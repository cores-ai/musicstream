# ========================================================
# Beats Stream - environment template
# Copy to .env and fill in your own values. NEVER commit .env
# ========================================================

PORT=8080
REQUIRE_API_KEY=true
API_KEY=replace_with_a_long_random_key

# Cloudflare D1 (optional) - rotating cookie pool
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# Cookies (optional) - point to a local Netscape cookie jar, gitignored
COOKIES_FILE=cookies.txt

# Cookies (optional) - raw Netscape content, single line only
YOUTUBE_COOKIES=

# Optional outbound proxy for yt-dlp
PROXY_URL=
